# StockPilot AI — Environment Configuration Example

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For local zero-dependency testing, defaults to sqlite:///./stockpilot.db
# For production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/stockpilot
DATABASE_URL=sqlite:///./stockpilot.db
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Groww Trading API (Market Data Provider)
# -----------------------------------------------------------------------------
# When GROWW_ACCESS_TOKEN is not supplied, the platform automatically activates
# a verified synthetic generator flagged as "demo_groww_mock".
GROWW_API_KEY=
GROWW_ACCESS_TOKEN=
GROWW_BASE_URL=https://api.groww.in/v1
GROWW_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# ICICI Direct Breeze API (Backup Market Data Provider)
# -----------------------------------------------------------------------------
# PyPI: breeze-connect (https://pypi.org/project/breeze-connect/)
# Generate API Key & Secret on https://api.icicidirect.com
ICICI_BREEZE_API_KEY=
ICICI_BREEZE_API_SECRET=
ICICI_BREEZE_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Financial News & Regulatory Disclosures
# -----------------------------------------------------------------------------
# Optional: Drishti API Key for Indian market corporate filings and transcripts
DRISHTI_API_KEY=
NEWS_FETCH_INTERVAL_MINUTES=30

# -----------------------------------------------------------------------------
# Machine Learning & Inference
# -----------------------------------------------------------------------------
MODEL_ARTIFACTS_DIR=./services/ml/artifacts
ACTIVE_MODEL_VERSION=v1.0.0-lgbm
CALIBRATION_METHOD=ISOTONIC

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
